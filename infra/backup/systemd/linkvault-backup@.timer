# Disparo nocturno del respaldo (ADR-066, design D10 de `staging-backups`): 06:30 UTC, alrededor de las 03:30 en Argentina, con un
# retraso aleatorio de hasta 15 minutos. `Persistent=true` recupera la corrida perdida si el host estaba apagado al llegar la hora
# (puede dispararse fuera de la franja sin despliegues de 06:15 a 08:45 UTC: el peor caso es una corrida fallida con aviso).
[Unit]
Description=Nightly LinkVault staging backup (%i)

[Timer]
OnCalendar=*-*-* 06:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
