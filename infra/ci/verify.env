# ===================================================================================================================
# ESTO NO ES UN FICHERO DE DESPLIEGUE. NO LO COPIES PARA DESPLEGAR NADA.
# ===================================================================================================================
# Valores de **relleno** para la verificación del artefacto en el corredor de CI (ADR-048 §4, tarea 5.2 del change
# `deploy-image-verification`): levantar `docker-compose.prod.yml` con las imágenes recién construidas y comprobar que
# `api`, `worker` y `web` arrancan de verdad. Nada de lo que hay aquí es un secreto: son cadenas inventadas, elegidas
# para que un lector distraído no pueda confundirlas con credenciales, y están versionadas a propósito para que la
# verificación sea reproducible y no dependa de ningún secret del repositorio.
#
# Para un despliegue real se parte de **`.env.example`** (sección "Producción"), que es el fichero que documenta cada
# variable, y se generan secretos propios con los comandos que allí se indican. Ver también `infra/README.md`.
#
# Por qué existe este fichero y no se escribe un compose para CI: la spec (`platform/ci-pipeline`, requirement
# "CD a staging en main") obliga a verificar con **el mismo** `docker-compose.prod.yml` que se despliega. Lo que MAY
# ser de relleno son los **valores**; el mapa de servicio a variable SHALL venir del fichero de producción, porque ahí
# es donde vivía el defecto que esta verificación existe para encontrar.
#
# Las cuatro variables de imagen y tag (`API_IMAGE`, `WORKER_IMAGE`, `WEB_IMAGE`, `IMAGE_TAG`) **no** están aquí a
# propósito (tarea 5.5): van como `env:` del step que ejecuta la verificación, calculadas con el tag local de esa
# corrida. Escritas aquí serían un valor fijo que envejece y que reintroduciría el espacio de nombres por defecto
# corregido en ADR-048 §4-bis.
# ===================================================================================================================

# --- Borde: Traefik NO se levanta en la verificación, pero sus variables sí se interpolan ---
# La interpolación de `${VAR:?}` ocurre al leer el fichero **entero**, antes de decidir qué servicios se piden, así que
# sin estas dos el `config` y el `up` abortan aunque `traefik` quede fuera de la selección (tarea 5.4).
PUBLIC_HOST=verify.invalid
ACME_EMAIL=ci@verify.invalid

# --- Comunes ---
LOG_LEVEL=info
FEATURE_HEADLESS_EXTRACTION=false

# --- api: sesión y tokens ---
# >= 32 caracteres y **distinto** del de `.env.example`: `apiConfigSchema` rechaza ese valor con NODE_ENV=production
# (`AUTH_JWT_SECRET_EXAMPLE`), y las imágenes hornean `NODE_ENV=production`.
AUTH_JWT_SECRET=ci-artifact-verification-only-not-a-real-jwt-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_MAX_DAYS=90
AUTH_VERIFY_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_SECONDS=3600

# --- api: outbox y lectura de descripción pegada ---
OUTBOX_RELAY_INTERVAL_MS=1000
PASTE_EXTRACTION_TIMEOUT_MS=20000

# --- URLs públicas: absolutas y **sin barra final** (`publicBaseUrl` la rechaza) ---
PUBLIC_PAGE_BASE_URL=http://api.verify.invalid
WEB_BASE_URL=http://web.verify.invalid

# --- Correo transaccional ---
# `smtp` a propósito, y no `capture`: `capture` se queda los mensajes sin entregarlos (ADR-048 §2) y además dejaría sin
# ejercitar la rama condicional del esquema. Con `smtp`, `MAIL_SMTP_HOST` y `MAIL_SMTP_PORT` son obligatorias en los
# **dos** procesos (el `superRefine` del worker las exige desde la tarea 4.4). El host no existe: en la verificación no
# se envía ningún correo, solo se comprueba que el proceso arranca con la configuración declarada.
MAIL_PROVIDER=smtp
MAIL_FROM=LinkVault CI <ci@verify.invalid>
MAIL_SMTP_HOST=smtp.verify.invalid
MAIL_SMTP_PORT=1025
RESEND_API_KEY=

# --- IA ---
# `none` y no `mock`: `parseAiConfig` **prohíbe** `mock` con `NODE_ENV=production`, que es lo que hornean las imágenes
# (`docker/api.Dockerfile`, `docker/worker.Dockerfile`) y lo que vuelve a fijar el compose. Con `mock` el proceso
# aborta antes de escuchar. Ver `openspec/changes/deploy-image-verification/inventarios.md` §1.2.
AI_CHAIN=none
# Obligatoria en producción **aunque `AI_CHAIN=none`** (`parseVaultKey`): base64 de exactamente 32 bytes.
# Valor de mentira legible: `echo bGlua3ZhdWx0LWNpLWZha2UtdmF1bHQta2V5LTMyYiE= | base64 -d` → texto, no una clave.
AI_VAULT_KEY=bGlua3ZhdWx0LWNpLWZha2UtdmF1bHQta2V5LTMyYiE=
AI_CACHE_TTL_SECONDS=604800

# --- Análisis de encaje (api y worker) ---
MATCH_ANALYSES_PER_USER=10
MATCH_QUOTA_WINDOW_MS=86400000
MATCH_ANALYSIS_MAX_AGE_MS=240000
MATCH_ANALYSIS_TIMEOUT_MS=120000
MATCH_ANALYSIS_CONCURRENCY=1

# --- worker: enriquecimiento ---
ENRICH_FETCH_TIMEOUT_MS=10000
ENRICH_MAX_BYTES=2097152
ENRICH_DOMAIN_DELAY_MS=2000
ENRICH_DEADLINE_MS=45000
ENRICH_ROBOTS_TTL_SECONDS=43200
ENRICH_USER_AGENT=LinkVaultBot/0.1 (+https://github.com/manuXD270516/linkvault)
ENRICH_CONCURRENCY=4
ENRICH_MAX_DEFERRALS=600

# --- worker: lectura del CV ---
CV_EXTRACTION_TIMEOUT_MS=30000
CV_EXTRACT_CONCURRENCY=1

# --- Almacenamiento de objetos (el servicio `object-store` dentro de la propia pila; ADR-052) ---
S3_REGION=us-east-1
S3_ACCESS_KEY=linkvault-ci
S3_SECRET_KEY=linkvault-ci-not-a-secret
S3_BUCKET=cvs
S3_SNAPSHOTS_BUCKET=snapshots
# Clave del cifrado del bucket de CV: 64 caracteres [0-9a-f], lo único que deja pasar el guardia de arranque del
# almacén (design D16 de `object-store`). Valor de mentira legible: es el hexadecimal del texto
# `linkvault-ci-only-sse-kek-000000`, no una clave.
OBJECT_STORE_SSE_KEY=6c696e6b7661756c742d63692d6f6e6c792d7373652d6b656b2d303030303030
