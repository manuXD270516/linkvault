# Configuración local de LinkVault. Copiar a `.env` (ignorado por git); Nx lo carga en `nx serve` y `nx test`.
# Solo valores de desarrollo: nunca secretos reales.

# --- Comunes a api y worker ---
NODE_ENV=development
LOG_LEVEL=info
# Desde el host, el replica set anuncia `mongo:27017`, que no resuelve: conexión directa al primario (D6).
# Desde un contenedor: mongodb://mongo:27017/linkvault?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017/linkvault?directConnection=true
REDIS_URL=redis://localhost:6379
FEATURE_HEADLESS_EXTRACTION=false
# Opcional: versión que exponen las rutas de salud; sin ella se usa la de package.json.
# APP_VERSION=0.0.0

# --- api ---
API_PORT=3000
# Sesión (ADR-012, ADR-020). Secreto HS256 del access token, mínimo 32 caracteres; este valor de ejemplo se rechaza con
# NODE_ENV=production. En producción usa uno propio, p. ej. 48 bytes aleatorios en base64url.
AUTH_JWT_SECRET=dev-only-change-me-not-a-real-jwt-secret
# Vida del access token en segundos (60-3600).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Caducidad deslizante del refresh token en días (1-90) y máximo absoluto de la sesión (hasta 365, >= la anterior).
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_MAX_DAYS=90
# Relay del outbox (ADR-009): publica en BullMQ los eventos que la transacción dejó en `outbox_events`. Con `false` no
# se registra la cola ni se abre conexión a Redis por esa vía y los eventos se acumulan hasta que vuelva a encenderse.
OUTBOX_RELAY_ENABLED=true
# Cada cuánto busca eventos pendientes vencidos, en milisegundos (100-300000).
OUTBOX_RELAY_INTERVAL_MS=1000
# Plazo de la lectura de una descripción pegada, en milisegundos (1000-120000). La IA corre dentro de la petición
# (paste-job-description, ADR-023): pasado este plazo se responde "no disponible" y el intento no cuenta.
PASTE_EXTRACTION_TIMEOUT_MS=20000
# URLs públicas absolutas, sin barra final (public-preview-share, ADR-027). NUNCA se deducen de la cabecera `Host` de
# una petición: acabarían dentro de una etiqueta Open Graph que los chats muestran y cachean.
# Origen que sirve la página pública `/p/:slug`, la que se pega en un chat.
PUBLIC_PAGE_BASE_URL=http://localhost:3000
# Origen del SPA: su vista pública `/oferta/:slug` y la imagen fija de las tarjetas. En producción pueden ser el mismo.
WEB_BASE_URL=http://localhost:4200

# --- worker ---
WORKER_HEALTH_PORT=3001

# --- Enriquecimiento de links (link-enrichment; ADR-003, ADR-022). Solo las lee el worker. ---
# Plazo de una descarga, en milisegundos (1000-60000). Es además lo que dura la exclusión del host mientras se descarga.
ENRICH_FETCH_TIMEOUT_MS=10000
# Tamaño máximo del HTML en bytes (65536-33554432); al superarlo se corta el flujo. 2 MiB: la página más grande medida
# pesaba 287 KB.
ENRICH_MAX_BYTES=2097152
# Espera mínima entre dos peticiones al mismo host, en milisegundos (250-300000). La espera real es el máximo entre
# esta y el `Crawl-delay` que pida el `robots.txt` del sitio: puede pedir más, nunca menos.
ENRICH_DOMAIN_DELAY_MS=2000
# Plazo total por link, en milisegundos (5000-300000, nunca menor que ENRICH_FETCH_TIMEOUT_MS). Se reparte entre las
# etapas de la cadena; lo que quede al llegar a la IA es lo que ella recibe, y si no queda nada esa etapa se salta.
ENRICH_DEADLINE_MS=45000
# Vida de la caché de `robots.txt` por host, en segundos (60-604800). También se cachea el "prohibido".
ENRICH_ROBOTS_TTL_SECONDS=43200
# Agente identificable con URL de contacto (ADR-003): es el que los sitios ven y contra el que se resuelve el grupo
# aplicable de su `robots.txt`.
ENRICH_USER_AGENT=LinkVaultBot/0.1 (+https://github.com/manuXD270516/linkvault)
# Jobs de enriquecimiento simultáneos en el proceso (1-64). Es global: un host a la vez lo garantiza el mutex de Redis.
ENRICH_CONCURRENCY=4
# Veces que un job puede aplazarse por encontrar su host ocupado antes de darse por fallido transitorio (1-10000).
# Holgado a propósito: aplazar no cuesta nada mientras el job está `delayed`, y cincuenta links de un mismo host rebotan
# cientos de veces antes de su turno. Solo evita que un host que nunca se libera rebote para siempre.
ENRICH_MAX_DEFERRALS=600

# --- IA (libs/ai; design-v0.2 §4.4 y §4.5, ADR-018) ---
# Las leen el worker (enriquecimiento) y api (descripción pegada, ADR-023); las valida `parseAiConfig` en los dos.
# Una variable vacía cuenta como ausente: se aplica su valor por defecto o, si es obligatoria, falla el arranque.
# Cadena ordenada de proveedores: `mock`, `ollama`, `openrouter` separados por comas, o `none` (sin IA: las tareas degradan).
# `mock` está prohibido con NODE_ENV=production. No añadas `openrouter` sin clave y modelo.
# AI_CHAIN=none
AI_CHAIN=mock
# Modo del mock (solo si `mock` está en AI_CHAIN): `synth` genera salidas en desarrollo; `replay` lee fixtures (tests y CI).
AI_MOCK_MODE=synth
# Rutas relativas al directorio de trabajo (en desarrollo y tests, la raíz del workspace). Un api o worker compilado que
# no arranque desde la raíz necesita AI_PROMPTS_DIR=dist/apps/<api|worker>/assets/ai/prompts o la ruta absoluta.
AI_PROMPTS_DIR=libs/ai/src/infrastructure/prompts
AI_FIXTURES_DIR=libs/ai/src/infrastructure/fixtures
# TTL de la caché de salidas en Redis, en segundos (no se usa si AI_CHAIN incluye `mock`).
AI_CACHE_TTL_SECONDS=604800
# Límites diarios por usuario y tarea; vacía = sin límites. Formato: classify-skills=100,extract-job=200
# `extract-pasted-job` (lo que lee api al pegar una descripción) tiene su propia cuota, independiente de `extract-job`.
AI_QUOTAS=

# Ollama (local): solo se lee si `ollama` está en AI_CHAIN. Desde un contenedor: http://ollama:11434
# Con la app de escritorio de Ollama basta OLLAMA_URL=http://localhost:11434. Si otro Ollama ya ocupa el 11434, el contenedor
# del perfil ai-local se publica en otro puerto (OLLAMA_PORT=11435) y OLLAMA_URL=http://localhost:11435.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MAX_CONTEXT_TOKENS=8192
OLLAMA_TIMEOUT_MS=60000

# OpenRouter (externo): solo se lee si `openrouter` está en AI_CHAIN; entonces la clave y el modelo son obligatorios.
# La URL base debe ser https salvo con NODE_ENV=test.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Credencial personal: solo en tu `.env`, nunca versionada.
OPENROUTER_API_KEY=
# Debe terminar en `:free` y admitir `data_collection: deny`; el valor por defecto se fija cuando haya una clave real (ver ADR-019).
OPENROUTER_MODEL=
OPENROUTER_MAX_CONTEXT_TOKENS=32000
OPENROUTER_TIMEOUT_MS=30000

# --- Almacenamiento de objetos: MinIO en local, cualquier S3 en producción ---
# El worker las lee para guardar los snapshots del enriquecimiento (ADR-022) y para leer el archivo de un CV; la API
# las lee para subirlo (ADR-028 §1), así que **las cinco son obligatorias en las dos apps**. docker compose usa además
# S3_ACCESS_KEY y S3_SECRET_KEY como credenciales de MinIO y crea **los dos buckets** al levantarlo.
S3_ENDPOINT=http://localhost:9000
# Región del cliente S3. MinIO la ignora, pero el protocolo la exige para firmar la petición.
S3_REGION=us-east-1
S3_ACCESS_KEY=linkvault
S3_SECRET_KEY=linkvault-dev-secret
# Copia comprimida de la página descargada, con expiración a 30 días (la crea el servicio `minio-init`).
S3_SNAPSHOTS_BUCKET=snapshots
# Bucket de los CV (ADR-006, ADR-028 §1): privado, **sin** regla de expiración —un CV no caduca solo— y sin política
# anónima. Lo leen `api` (para subir el archivo) y `worker` (para leerlo y para borrarlo); la clave es `<userId>/<cvId>`,
# sin el nombre del archivo. El nombre no puede ser `cv`: S3 y MinIO exigen entre 3 y 63 caracteres.
S3_BUCKET=cvs

# --- Lectura del CV en el worker (ADR-028 §7) ---
# Plazo de la extracción entera, en milisegundos: un PDF malformado puede tener a un parser dando vueltas. Vencido, el
# CV queda en `failed` con `unreadable_file`, que para quien lo subió es indistinguible de un archivo roto, y lo es.
CV_EXTRACTION_TIMEOUT_MS=30000
# Extracciones a la vez en el proceso. El parseo es trabajo de CPU en el hilo principal: con 1, un PDF pesado retrasa
# al siguiente CV y no a todo el worker.
CV_EXTRACT_CONCURRENCY=1

# --- Solo docker compose: puertos publicados en el host (por defecto, los estándar) ---
# MONGO_PORT=27017
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OLLAMA_PORT=11434