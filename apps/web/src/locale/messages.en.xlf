<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="es" target-language="en" datatype="plaintext" original="ng2.template">
    <body>
      <trans-unit id="app.connecting" datatype="html">
        <source>Conectando…</source>
        <target>Connecting…</target>
      </trans-unit>
      <trans-unit id="login.title" datatype="html">
        <source>Iniciar sesión</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="auth.email" datatype="html">
        <source>Email</source>
        <target>Email</target>
      </trans-unit>
      <trans-unit id="auth.emailInvalid" datatype="html">
        <source>Introduce un email válido</source>
        <target>Enter a valid email</target>
      </trans-unit>
      <trans-unit id="auth.password" datatype="html">
        <source>Contraseña</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="auth.hidePassword" datatype="html">
        <source>Ocultar</source>
        <target>Hide</target>
      </trans-unit>
      <trans-unit id="auth.showPassword" datatype="html">
        <source>Mostrar</source>
        <target>Show</target>
      </trans-unit>
      <trans-unit id="login.passwordRequired" datatype="html">
        <source>Introduce tu contraseña</source>
        <target>Enter your password</target>
      </trans-unit>
      <trans-unit id="login.invalidCredentials" datatype="html">
        <source> Email o contraseña incorrectos </source>
        <target>Incorrect email or password</target>
      </trans-unit>
      <trans-unit id="login.submit" datatype="html">
        <source> Entrar </source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="login.noAccount" datatype="html">
        <source> ¿No tienes cuenta? <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/registro&quot; [queryParams]=&quot;returnQueryParams&quot;&gt;"/>Crear cuenta<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a&gt;"/></source>
        <target>Don't have an account? <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/registro&quot; [queryParams]=&quot;returnQueryParams&quot;&gt;"/>Create account<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a&gt;"/></target>
      </trans-unit>
      <trans-unit id="register.title" datatype="html">
        <source>Crear cuenta</source>
        <target>Create account</target>
      </trans-unit>
      <trans-unit id="register.displayName" datatype="html">
        <source>Nombre</source>
        <target>Name</target>
      </trans-unit>
      <trans-unit id="register.displayNameInvalid" datatype="html">
        <source>Escribe un nombre de hasta 60 caracteres</source>
        <target>Enter a name of up to 60 characters</target>
      </trans-unit>
      <trans-unit id="auth.passwordHint" datatype="html">
        <source>Mínimo 10 caracteres</source>
        <target>At least 10 characters</target>
      </trans-unit>
      <trans-unit id="register.passwordInvalid" datatype="html">
        <source>La contraseña debe tener entre 10 y 128 caracteres</source>
        <target>The password must be between 10 and 128 characters</target>
      </trans-unit>
      <trans-unit id="register.passwordIsEmail" datatype="html">
        <source> La contraseña no puede ser tu email </source>
        <target>The password can't be your email</target>
      </trans-unit>
      <trans-unit id="register.dataNotice" datatype="html">
        <source> Usamos tu email para iniciar sesión y tu nombre para mostrarte en tus grupos. No lo compartimos fuera de LinkVault. </source>
        <target>We use your email to sign you in and your name to show you in your groups. We don't share it outside LinkVault.</target>
      </trans-unit>
      <trans-unit id="register.emailTaken" datatype="html">
        <source> Ya existe una cuenta con este email. <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/login&quot; [queryParams]=&quot;returnQueryParams&quot; [state]=&quot;{ email: attemptedEmail() }&quot;
            &gt;"/>¿Quieres iniciar sesión?<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a
          &gt;"/></source>
        <target>An account with this email already exists. <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/login&quot; [queryParams]=&quot;returnQueryParams&quot; [state]=&quot;{ email: attemptedEmail() }&quot;
            &gt;"/>Do you want to sign in?<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a
          &gt;"/></target>
      </trans-unit>
      <trans-unit id="register.submit" datatype="html">
        <source> Crear cuenta </source>
        <target>Create account</target>
      </trans-unit>
      <trans-unit id="register.haveAccount" datatype="html">
        <source> ¿Ya tienes cuenta? <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/login&quot; [queryParams]=&quot;returnQueryParams&quot;&gt;"/>Inicia sesión<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a&gt;"/></source>
        <target>Already have an account? <x id="START_LINK" ctype="x-a" equiv-text="&lt;a routerLink=&quot;/login&quot; [queryParams]=&quot;returnQueryParams&quot;&gt;"/>Sign in<x id="CLOSE_LINK" ctype="x-a" equiv-text="&lt;/a&gt;"/></target>
      </trans-unit>
      <trans-unit id="home.greeting" datatype="html">
        <source>Hola, <x id="INTERPOLATION" equiv-text="{{ displayName() }}"/></source>
        <target>Hi, <x id="INTERPOLATION" equiv-text="{{ displayName() }}"/></target>
      </trans-unit>
      <trans-unit id="profile.title" datatype="html">
        <source>Perfil</source>
        <target>Profile</target>
      </trans-unit>
      <trans-unit id="profile.displayName" datatype="html">
        <source>Nombre</source>
        <target>Name</target>
      </trans-unit>
      <trans-unit id="profile.displayNameInvalid" datatype="html">
        <source>Escribe un nombre de hasta 60 caracteres</source>
        <target>Enter a name of up to 60 characters</target>
      </trans-unit>
      <trans-unit id="profile.nameSaved" datatype="html">
        <source>Nombre guardado</source>
        <target>Name saved</target>
      </trans-unit>
      <trans-unit id="profile.saveName" datatype="html">
        <source> Guardar nombre </source>
        <target>Save name</target>
      </trans-unit>
      <trans-unit id="profile.passwordTitle" datatype="html">
        <source>Cambiar la contraseña</source>
        <target>Change your password</target>
      </trans-unit>
      <trans-unit id="profile.currentPassword" datatype="html">
        <source>Contraseña actual</source>
        <target>Current password</target>
      </trans-unit>
      <trans-unit id="profile.currentPasswordRequired" datatype="html">
        <source>Introduce tu contraseña actual</source>
        <target>Enter your current password</target>
      </trans-unit>
      <trans-unit id="profile.newPassword" datatype="html">
        <source>Nueva contraseña</source>
        <target>New password</target>
      </trans-unit>
      <trans-unit id="profile.newPasswordInvalid" datatype="html">
        <source>La nueva contraseña debe tener al menos 10 caracteres y no puede ser tu email</source>
        <target>The new password must be at least 10 characters long and can't be your email</target>
      </trans-unit>
      <trans-unit id="profile.passwordChanged" datatype="html">
        <source> Contraseña cambiada. Cerramos tu sesión en los demás dispositivos. </source>
        <target>Password changed. We signed you out on your other devices.</target>
      </trans-unit>
      <trans-unit id="profile.wrongCurrentPassword" datatype="html">
        <source> La contraseña actual no es correcta </source>
        <target>The current password is incorrect</target>
      </trans-unit>
      <trans-unit id="profile.changePassword" datatype="html">
        <source> Cambiar contraseña </source>
        <target>Change password</target>
      </trans-unit>
      <trans-unit id="shell.brand" datatype="html">
        <source>LinkVault</source>
        <target>LinkVault</target>
      </trans-unit>
      <trans-unit id="shell.profile" datatype="html">
        <source>Perfil</source>
        <target>Profile</target>
      </trans-unit>
      <trans-unit id="shell.logout" datatype="html">
        <source> Cerrar sesión </source>
        <target>Sign out</target>
      </trans-unit>
      <trans-unit id="error.tooManyAttempts" datatype="html">
        <source>Demasiados intentos. Vuelve a intentarlo en <x id="INTERPOLATION" equiv-text="{{ minutes }}"/> <x id="ICU" equiv-text="{minutes, plural, =1 {minuto} other {minutos}}" xid="4693155463045116188"/></source>
        <target>Too many attempts. Try again in <x id="INTERPOLATION" equiv-text="{{ minutes }}"/> <x id="ICU" equiv-text="{minutes, plural, =1 {minuto} other {minutos}}" xid="4693155463045116188"/></target>
      </trans-unit>
      <trans-unit id="4693155463045116188" datatype="html">
        <source>{VAR_PLURAL, plural, =1 {minuto} other {minutos}}</source>
        <target>{VAR_PLURAL, plural, =1 {minute} other {minutes}}</target>
      </trans-unit>
      <trans-unit id="error.tooManyAttemptsLater" datatype="html">
        <source>Demasiados intentos. Vuelve a intentarlo más tarde</source>
        <target>Too many attempts. Try again later</target>
      </trans-unit>
      <trans-unit id="error.offline" datatype="html">
        <source>No pudimos conectar con LinkVault. Revisa tu conexión</source>
        <target>We couldn't connect to LinkVault. Check your connection</target>
      </trans-unit>
      <trans-unit id="error.unknown" datatype="html">
        <source>Algo salió mal. Inténtalo de nuevo</source>
        <target>Something went wrong. Please try again</target>
      </trans-unit>
    </body>
  </file>
</xliff>
