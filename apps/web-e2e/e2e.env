# ===================================================================================================================
# ESTO NO ES UN FICHERO DE DESPLIEGUE. NO LO COPIES PARA DESPLEGAR NADA.
# ===================================================================================================================
# Entorno **versionado** de la suite end-to-end (change `e2e-suite`, design D6; ADR-053 §3). Es el único entorno que
# llega a las aplicaciones (`api`, `worker`, `web`), a `docker compose` y a Playwright cuando los lanza el runner
# (`pnpm nx run web-e2e:e2e-stack`): el runner **no** les hereda su propio entorno, al que Nx ya ha cargado el `.env` de
# quien ejecuta; les pasa una lista blanca de variables del sistema, estas y las de control
# (`NX_LOAD_DOT_ENV_FILES=false`, `NX_DAEMON=false`, `COMPOSE_PROJECT_NAME`). Compose lo recibe con `--env-file`, así
# que tampoco lee el `.env` de la raíz.
#
# **Sin secretos**: todo son valores de relleno para una pila desechable que vive lo que dura una corrida (proyecto de
# compose `linkvault-e2e-<hash8>`, borrado con sus volúmenes al terminar). Para desplegar se parte de `.env.example`.
#
# El **bloque de puertos** por defecto vive aquí (design D4). Las anulaciones son **flags** del runner (`--api-port`,
# `--mongo-port`…), nunca variables de entorno: el runner recalcula desde el bloque efectivo los puertos y las URIs de
# este fichero (`MONGO_URI`, `REDIS_URL`, `S3_ENDPOINT`, `WEB_BASE_URL`…).
#
# Formato: `CLAVE=valor` sin comillas, sin `#` ni `$` dentro de los valores (lo leen el runner y compose).
# ===================================================================================================================

# --- Bloque de puertos: variables de interpolación de docker-compose.yml (design D4) ---
MONGO_PORT=27117
REDIS_PORT=6479
MAILPIT_SMTP_PORT=1125
MAILPIT_UI_PORT=8125
# Almacén S3 del compose de 35a (`object-store`).
OBJECT_STORE_PORT=9100
# MinIO del compose **anterior** a 35a: sin estas dos, MinIO publicaría 9000/9001, fuera del bloque, y la fase de
# infraestructura fallaría. La tarea 7.9 las retira al pasar a `pnpm infra:up`.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- Comunes a api y worker ---
NODE_ENV=development
LOG_LEVEL=info
MONGO_URI=mongodb://localhost:27117/linkvault?directConnection=true
REDIS_URL=redis://localhost:6479
FEATURE_HEADLESS_EXTRACTION=false

# --- Flags de producto: apagados (ninguna prueba del lote 1 los necesita; un lote que admita una prueba con flag lo
# enciende aquí, design D6) ---
FEATURE_SEARCH=false
FEATURE_DISCOVERY=false
FEATURE_LINK_FRESHNESS=false
FEATURE_GROUP_DIGEST=false
DISCOVERY_CHAIN=mock

# --- api (puerto del bloque) ---
API_PORT=3100
AUTH_JWT_SECRET=e2e-suite-only-not-a-real-jwt-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_MAX_DAYS=90
AUTH_VERIFY_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_SECONDS=3600
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
PASTE_EXTRACTION_TIMEOUT_MS=20000
EXTENSION_CORS_ORIGINS=

# --- URLs públicas del bloque: absolutas y sin barra final. `WEB_BASE_URL` fija además el puerto de `web` ---
WEB_BASE_URL=http://localhost:4300
PUBLIC_PAGE_BASE_URL=http://localhost:3100

# --- worker (salud en el puerto del bloque) ---
WORKER_HEALTH_PORT=3101

# --- Correo: SMTP al Mailpit del proyecto de compose de la suite, nunca a un proveedor real (design D8) ---
MAIL_PROVIDER=smtp
MAIL_FROM=LinkVault E2E <noreply@example.com>
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1125
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:e2e@example.com

# --- IA: replay determinista (design D7). `synth` convertiría una entrada sin fixture en una salida inventada ---
AI_CHAIN=mock
AI_MOCK_MODE=replay
AI_EMBED_CHAIN=mock
AI_PROMPTS_DIR=libs/ai/src/infrastructure/prompts
AI_FIXTURES_DIR=libs/ai/src/infrastructure/fixtures
AI_CACHE_TTL_SECONDS=604800
AI_QUOTAS=match-cv=10,build-roadmap=10

# --- Análisis de encaje (api y worker; MATCH_ANALYSIS_MAX_AGE_MS igual en los dos) ---
MATCH_ANALYSES_PER_USER=10
MATCH_QUOTA_WINDOW_MS=86400000
MATCH_ANALYSIS_MAX_AGE_MS=240000
MATCH_ANALYSIS_TIMEOUT_MS=120000
MATCH_ANALYSIS_CONCURRENCY=1

# --- worker: enriquecimiento ---
ENRICH_FETCH_TIMEOUT_MS=10000
ENRICH_MAX_BYTES=2097152
ENRICH_DOMAIN_DELAY_MS=2000
ENRICH_DEADLINE_MS=45000
ENRICH_ROBOTS_TTL_SECONDS=43200
ENRICH_USER_AGENT=LinkVaultBot/0.1 (+https://github.com/manuXD270516/linkvault)
ENRICH_CONCURRENCY=4
ENRICH_MAX_DEFERRALS=600

# --- worker: lectura del CV ---
CV_EXTRACTION_TIMEOUT_MS=30000
CV_EXTRACT_CONCURRENCY=1

# --- Almacenamiento de objetos del bloque (credenciales de relleno; compose las usa para el servidor S3 local) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=linkvault-e2e
S3_SECRET_KEY=linkvault-e2e-not-a-secret
S3_BUCKET=cvs
S3_SNAPSHOTS_BUCKET=snapshots

# --- Cuenta del ensayo remoto (`--rehearse-remote`, design D10): alias `+e2e`, solo contra la pila local ---
E2E_REHEARSAL_EMAIL=rehearsal+e2e@example.com
E2E_REHEARSAL_PASSWORD=e2e-rehearsal-not-a-secret
