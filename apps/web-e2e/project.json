{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["scope:web", "type:tooling", "platform:node"],
  "implicitDependencies": ["web"],
  "// targets": "to see all targets run: nx show project web-e2e --web",
  "targets": {
    "typecheck": {
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.json", "tsc --noEmit -p scripts/tsconfig.json"]
      }
    },
    "e2e-stack": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import tsx apps/web-e2e/scripts/e2e-stack.ts",
        "cwd": ".",
        "env": {
          "TSX_TSCONFIG_PATH": "apps/web-e2e/scripts/tsconfig.json"
        }
      }
    }
  }
}
