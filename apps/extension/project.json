{
  "name": "extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/extension/src",
  "tags": ["scope:extension", "type:app", "platform:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/extension"],
      "cache": true,
      "inputs": ["production", "^production"],
      "defaultConfiguration": "development",
      "options": {
        "command": "vite build",
        "cwd": "apps/extension"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "typecheck": {
      "options": {
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    }
  }
}
