{
  "name": "ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ai/src",
  "projectType": "library",
  "tags": ["scope:ai", "type:lib", "platform:node"],
  "// targets": "to see all targets run: nx show project ai --web",
  "targets": {
    "typecheck": {
      "options": {
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx libs/ai/src/evals/cli/eval.ts",
        "cwd": ".",
        "env": {
          "TSX_TSCONFIG_PATH": "libs/ai/tsconfig.lib.json"
        }
      }
    },
    "eval-ci": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import tsx libs/ai/src/evals/cli/eval.ts --all --provider=mock",
        "cwd": ".",
        "env": {
          "TSX_TSCONFIG_PATH": "libs/ai/tsconfig.lib.json"
        }
      }
    },
    "record-fixtures": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx libs/ai/src/evals/cli/record-fixtures.ts",
        "cwd": ".",
        "env": {
          "TSX_TSCONFIG_PATH": "libs/ai/tsconfig.lib.json"
        }
      }
    },
    "export-feedback-candidates": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx libs/ai/src/evals/cli/export-feedback-candidates.ts",
        "cwd": ".",
        "env": {
          "TSX_TSCONFIG_PATH": "libs/ai/tsconfig.lib.json"
        }
      }
    }
  }
}
