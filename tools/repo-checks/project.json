{
  "name": "repo-checks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/repo-checks/src",
  "projectType": "library",
  "tags": ["scope:tooling", "type:tooling", "platform:node"],
  "// regla 1": "UN TARGET POR COMPROBACIÓN. Cada comprobación es un target 'check-<nombre>' con sus 'inputs' EXPLÍCITOS, que nombran uno a uno los ficheros que lee. Sin esa lista, Nx restauraría un verde cacheado cuando cambie justo el fichero que la comprobación mira (ADR-048 §5).",
  "// regla 2": "UN AGREGADOR QUE DEPENDA DE TODOS. El target 'check' lleva en 'dependsOn' todos los 'check-*' y ejecuta src/aggregate.mjs, que falla si no queda ninguno o si alguno se quedó fuera del dependsOn.",
  "targets": {
    "check-compose-healthchecks": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docker-compose.prod.yml",
        "{projectRoot}/src/compose-healthchecks.check.mjs",
        "{projectRoot}/src/lib/compose.mjs",
        "{projectRoot}/src/lib/report.mjs"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node tools/repo-checks/src/compose-healthchecks.check.mjs"
        ]
      }
    },
    "check-compose-env-contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docker-compose.prod.yml",
        "{workspaceRoot}/apps/api/src/infrastructure/config/api-config.schema.ts",
        "{workspaceRoot}/apps/worker/src/infrastructure/config/worker-config.schema.ts",
        "{projectRoot}/src/compose-env-contract.check.mjs",
        "{projectRoot}/src/lib/compose.mjs",
        "{projectRoot}/src/lib/zod-env-schema.mjs",
        "{projectRoot}/src/lib/report.mjs"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node tools/repo-checks/src/compose-env-contract.check.mjs"
        ]
      }
    },
    "check-claims-registry": {
      "executor": "nx:run-commands",
      "cache": true,
      "// inputs": "Los archivos del alcance declarado en claims.registry.mjs (docs/ sin docs/adr/, apps/ y libs/) más los símbolos que desmienten la afirmación. Sin ellos Nx restauraría un verde cacheado justo cuando cambia el fichero que la comprobación mira (ADR-048 §5).",
      "inputs": [
        "{workspaceRoot}/docs/**/*.md",
        "!{workspaceRoot}/docs/adr/**",
        "{workspaceRoot}/apps/**/*.ts",
        "{workspaceRoot}/libs/**/*.ts",
        "{projectRoot}/src/claims-registry.check.mjs",
        "{projectRoot}/src/claims.registry.mjs",
        "{projectRoot}/src/lib/compose.mjs",
        "{projectRoot}/src/lib/report.mjs"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": ["node tools/repo-checks/src/claims-registry.check.mjs"]
      }
    },
    "check-stale-defaults": {
      "executor": "nx:run-commands",
      "cache": true,
      "// inputs": "Los tres sitios donde vive un valor por defecto, uno a uno. Ningún fichero de test: ver el alcance declarado en stale-defaults.registry.mjs.",
      "inputs": [
        "{workspaceRoot}/.env.example",
        "{workspaceRoot}/docker-compose.prod.yml",
        "{workspaceRoot}/libs/ai/src/infrastructure/config/ai-config.schema.ts",
        "{projectRoot}/src/stale-defaults.check.mjs",
        "{projectRoot}/src/stale-defaults.registry.mjs",
        "{projectRoot}/src/lib/compose.mjs",
        "{projectRoot}/src/lib/report.mjs"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": ["node tools/repo-checks/src/stale-defaults.check.mjs"]
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "check-compose-healthchecks",
        "check-compose-env-contract",
        "check-claims-registry",
        "check-stale-defaults"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": ["node tools/repo-checks/src/aggregate.mjs"]
      }
    }
  }
}
