/**
 * Datos a mano de cada caso de la guía: ruta, qué se escribe o pulsa, qué se espera y qué prueba automatizada lo cubre.
 * Lo que se vio y el OK/FALLO salen de `resultados.json` (lo escribe `capture.mts`). `build-guide.mts` los junta.
 *
 * Abreviaturas de prueba: `e2e:` es un spec de `apps/web-e2e/src/`; `unit:` es un spec de Vitest de
 * `apps/web/src/app/` (sin el prefijo de carpeta común).
 */
export interface CaseMeta {
  /** Ruta de la SPA (o la pantalla). */
  r: string;
  /** Qué se escribe y qué botón se pulsa. */
  e: string;
  /** Qué debe pasar (spec o catálogo). */
  x: string;
  /** Prueba automatizada que lo cubre, o «sin prueba automatizada». */
  t: string;
  /** Identificador de hallazgo si el caso lo evidencia. */
  h?: string;
}

const NONE = 'sin prueba automatizada';

